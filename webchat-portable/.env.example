# Connect to the SAME PostgreSQL database as the Referral portal.
DATABASE_URL="postgresql://postgres:password@host:port/database"

# Required by the optional staff badge. Use the Auth Hub shared secret.
JWT_SECRET="shared-secret-from-auth-hub"
APP_BASE_URL="http://localhost:3000"
AUTH_HUB_URL="https://auth.atap.solar"

# Use the SAME session and tenant values to share web-chat history and agent state.
WHATSAPP_AGENT_BAILEYS_SESSION_ID="0182920127"
WHATSAPP_AGENT_TENANT_ID="1"

# Optional: if all three proxy values are set, the agent uses the SQL proxy
# instead of DATABASE_URL for its referral and conversation queries.
# WHATSAPP_AGENT_PROXY_URL="https://pg-proxy.example.com"
# WHATSAPP_AGENT_PROXY_AUTH="Bearer ..."
# WHATSAPP_AGENT_PROXY_DB_NAME="prod_main"

# Required for assistant replies and image uploads.
AI_API_KEY=""
AI_BASE_URL="https://api.example.com/v1"
AI_MODEL="your-multimodal-model"

# Optional. This URL is included in assistant guidance.
WHATSAPP_AGENT_PORTAL_URL="https://referral.atap.solar/"
